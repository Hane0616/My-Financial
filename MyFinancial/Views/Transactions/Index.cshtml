@model IEnumerable<MyFinancial.Models.Transaction> 

@{
    ViewData["Title"] = "收支紀錄"; // 設定頁面標題
}

<div class="container mt-4"> @* 使用 Bootstrap 容器與上方間距 *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>收支紀錄</h1> @* 頁面主標題 *@
        <a asp-action="Create" class="btn btn-primary">新增收支</a> @* 前往新增表單 *@
    </div>

    @if (Model.Any()) // 如果資料庫中有收支紀錄
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover"> @* 建立收支資料表 *@
                <thead>
                    <tr>
                        <th>日期</th>
                        <th>名稱</th>
                        <th>類型</th>
                        <th>分類</th>
                        <th class="text-end">金額</th>
                        <th>備註</th>
                        <th>操作</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) // 逐筆顯示收支紀錄
                    {
                        <tr>
                            <td>@item.Date.ToString("yyyy/MM/dd")</td> @* 格式化日期 *@
                            <td>@item.Title</td> @* 顯示交易名稱 *@
                            <td>@(item.Type == "Income" ? "收入" : "支出")</td> @* 顯示中文類型 *@
                            <td>@item.Category</td> @* 顯示分類 *@
                            <td class="text-end">@item.Amount.ToString("N0")</td> @* 顯示千分位金額 *@
                            <td>@item.Note</td> 
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-sm btn-outline-primary">編輯</a>
                                 <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">刪除</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-light border">目前還沒有收支紀錄，請新增第一筆資料。</div> @* 空資料提示 *@
    }
</div>